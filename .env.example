GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-decision-1
PORT=8787
RATE_LIMIT_PER_MIN=20
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=token-with-workers-ai-access
# Where the answer database is stored (SQLite).
DB_FILE=data/answers.db
# Trust Cloudflare's cf-connecting-ip header for rate limiting. Defaults to 1 when HOST is loopback,
# 0 otherwise. Set 1 only if the port is reachable solely through the Cloudflare tunnel.
# TRUST_CF_IP=1
